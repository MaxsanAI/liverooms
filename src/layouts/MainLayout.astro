---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "LiveRooms — Live conversations, real people",
  description = "Join live audio rooms, discover conversations and connect with people around the world."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="theme-color" content="#09090b" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" />
  </head>

  <body>
    <slot />
  </body>
</html>
