---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/global.css";

const { id } = Astro.params;
const autoHost = Astro.url.searchParams.get("role") === "host";
---

<MainLayout title="Live Room — LiveRooms" description="Join a live conversation on LiveRooms.">
  <main class="room-page">
    <a href="/" class="back-link">← LiveRooms</a>

    <section class="room-shell" data-room-id={id} data-auto-host={autoHost ? "true" : "false"}>
      <div id="room-info" class="room-info">
        <div class="live-pill"><span></span> LIVE ROOM</div>
        <p class="room-id">Room {id}</p>
        <h1>Join the conversation.</h1>
        <p>Enter your name and join this live room.</p>

        <div class="join-panel" id="join-panel" hidden={autoHost}>
          <label>
            <span>Your name</span>
            <input id="participant-name" maxlength="80" placeholder="Your name" value="Guest" />
          </label>

          <button type="button" id="join-room" class="primary-button">Join Live Room</button>
        </div>

        <p id="room-status" class="room-status" aria-live="polite">Ready to join.</p>
      </div>

      <div id="meeting-wrap" class="meeting-wrap" hidden>
        <div class="meeting-topbar">
          <a href="/" class="meeting-back">← Leave room</a>
          <span class="meeting-label">LiveRooms Audio</span>
        </div>
        <div id="meeting-container" class="meeting-container">
          <rtk-meeting id="rtk-meeting" show-setup-screen="true"></rtk-meeting>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script type="module">
  const roomShell = document.querySelector(".room-shell");
  const roomId = roomShell?.getAttribute("data-room-id") || "";
  const params = new URLSearchParams(window.location.search);
  const requestedRole = params.get("role") === "host" ? "host" : "listener";

  const roomInfo = document.querySelector("#room-info");
  const meetingWrap = document.querySelector("#meeting-wrap");
  const status = document.querySelector("#room-status");
  const nameInput = document.querySelector("#participant-name");
  const joinButton = document.querySelector("#join-room");
  const meetingElement = document.querySelector("#rtk-meeting");

  const setStatus = (message) => {
    if (status) status.textContent = message;
  };

  if (!roomShell || !roomId || !roomInfo || !meetingWrap || !status || !nameInput || !meetingElement) {
    throw new Error("Live room UI could not initialize.");
  }

  const isHost = roomShell.getAttribute("data-auto-host") === "true";

  const savedId = localStorage.getItem("liverooms-participant-id") || crypto.randomUUID();
  localStorage.setItem("liverooms-participant-id", savedId);

  const savedName = localStorage.getItem("liverooms-participant-name");
  if (savedName) nameInput.value = savedName;

  let RealtimeKitClient = null;
  let sdkPromise = null;

  async function loadRealtimeKit() {
    if (RealtimeKitClient) return RealtimeKitClient;

    if (!sdkPromise) {
      sdkPromise = Promise.all([
        import("https://cdn.jsdelivr.net/npm/@cloudflare/realtimekit@latest/dist/index.es.js"),
        import("https://cdn.jsdelivr.net/npm/@cloudflare/realtimekit-ui@latest/loader/index.es2017.js")
      ]).then(([core, ui]) => {
        ui.defineCustomElements();
        RealtimeKitClient = core.default || core.RealtimeKitClient;
        if (!RealtimeKitClient) throw new Error("RealtimeKit SDK failed to load.");
        return RealtimeKitClient;
      });
    }

    return sdkPromise;
  }

  async function joinRoom() {
    const name = String(nameInput.value || "Guest").trim().slice(0, 80) || "Guest";
    localStorage.setItem("liverooms-participant-name", name);

    if (joinButton) joinButton.disabled = true;
    setStatus("Connecting to the live room…");

    try {
      const response = await fetch(`/api/rooms/${roomId}/join`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          participantId: savedId,
          name,
          role: requestedRole
        })
      });

      const result = await response.json();

      if (!response.ok || !result.token) {
        throw new Error(result.error || "Could not join the room.");
      }

      setStatus(
        result.role === "host"
          ? "You are the host. Loading the audio room…"
          : "Connected. Loading audio room…"
      );

      roomInfo.hidden = true;
      meetingWrap.hidden = false;

      const Client = await loadRealtimeKit();
      const meeting = await Client.init({ authToken: result.token });

      meetingElement.meeting = meeting;
      await meeting.join();
    } catch (error) {
      roomInfo.hidden = false;
      meetingWrap.hidden = true;
      if (joinButton) joinButton.disabled = false;
      setStatus(error instanceof Error ? error.message : "Could not join the room.");
      console.error("LiveRooms join error:", error);
    }
  }

  if (joinButton) {
    joinButton.addEventListener("click", () => {
      void joinRoom();
    });
  }

  if (isHost) {
    void joinRoom();
  }
</script>

<style>
  .room-page {
    min-height: 100vh;
    padding: 32px 20px;
  }

  .back-link {
    color: var(--muted);
    text-decoration: none;
  }

  .room-shell {
    width: min(1100px, 100%);
    margin: 48px auto 0;
  }

  .room-info {
    padding: clamp(28px, 6vw, 64px);
    border: 1px solid var(--border);
    border-radius: 30px;
    background: rgba(18, 18, 24, .82);
    text-align: center;
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid rgba(34, 197, 94, .25);
    border-radius: 999px;
    color: #86efac;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .live-pill span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
  }

  .room-id {
    color: var(--muted);
    font-size: .8rem;
    word-break: break-all;
    margin: 22px 0 0;
  }

  h1 {
    margin: 14px 0;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
  }

  .room-info > p:not(.room-id):not(.room-status) {
    color: var(--muted);
    line-height: 1.7;
  }

  .join-panel {
    width: min(520px, 100%);
    margin: 34px auto 0;
    text-align: left;
  }

  label {
    display: grid;
    gap: 9px;
    color: #d8d8e2;
    font-size: .9rem;
    font-weight: 700;
  }

  input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #101016;
    color: white;
    padding: 14px 15px;
    font: inherit;
    outline: none;
  }

  input:focus {
    border-color: rgba(167, 139, 250, .8);
    box-shadow: 0 0 0 3px rgba(167, 139, 250, .12);
  }

  .primary-button {
    width: 100%;
    margin-top: 16px;
    border: 0;
    border-radius: 14px;
    padding: 15px 18px;
    color: white;
    background: linear-gradient(135deg, #7c3aed, #06b6d4);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  button:disabled {
    opacity: .55;
    cursor: wait;
  }

  .room-status {
    min-height: 24px;
    margin: 22px 0 0;
    color: var(--muted);
  }

  .meeting-wrap {
    min-height: calc(100vh - 110px);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: #050507;
  }

  .meeting-topbar {
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(12, 12, 17, .96);
  }

  .meeting-back {
    color: var(--muted);
    text-decoration: none;
    font-size: .88rem;
  }

  .meeting-label {
    color: #d8d8e2;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .meeting-container {
    height: calc(100vh - 165px);
    min-height: 560px;
  }

  rtk-meeting {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 640px) {
    .room-page {
      padding: 22px 12px;
    }

    .room-shell {
      margin-top: 34px;
    }

    .meeting-wrap {
      border-radius: 16px;
    }

    .meeting-container {
      min-height: 520px;
      height: calc(100vh - 130px);
    }
  }
</style>
