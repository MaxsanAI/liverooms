---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
---

<MainLayout title="Create a Room — LiveRooms" description="Start a live conversation on LiveRooms.">
  <main class="page-shell">
    <section class="create-panel">
      <a class="back-link" href="/">← Back to LiveRooms</a>

      <div class="eyebrow">START A CONVERSATION</div>
      <h1>Create your room</h1>
      <p class="lead">Set up the room now. The live audio connection will be created through LiveRooms' realtime backend.</p>

      <form id="create-room-form" class="room-form">
        <label>
          <span>Room title</span>
          <input name="title" maxlength="120" required placeholder="What do you want to talk about?" />
        </label>

        <label>
          <span>Description</span>
          <textarea name="description" maxlength="500" rows="4" placeholder="Give people a reason to join."></textarea>
        </label>

        <div class="form-grid">
          <label>
            <span>Category</span>
            <select name="category">
              <option>General</option>
              <option>Technology</option>
              <option>Entertainment</option>
              <option>Music</option>
              <option>Sports</option>
              <option>News & Culture</option>
              <option>Gaming</option>
              <option>Business</option>
            </select>
          </label>

          <label>
            <span>Language</span>
            <select name="language">
              <option value="en">English</option>
              <option value="sr">Serbian</option>
              <option value="de">Deutsch</option>
              <option value="es">Español</option>
              <option value="fr">Français</option>
              <option value="it">Italiano</option>
              <option value="pt">Português</option>
            </select>
          </label>
        </div>

        <button type="submit" class="primary-button">Create Room</button>
        <p id="form-status" class="form-status" aria-live="polite"></p>
      </form>
    </section>
  </main>
</MainLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#create-room-form");
  const status = document.querySelector<HTMLParagraphElement>("#form-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    status.textContent = "Creating room…";

    const data = new FormData(form);
    const payload = {
      title: String(data.get("title") || ""),
      description: String(data.get("description") || ""),
      category: String(data.get("category") || "General"),
      language: String(data.get("language") || "en")
    };

    try {
      const response = await fetch("/api/rooms", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload)
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || "Could not create the room.");
      }

      window.location.href = `/room/${result.room.id}?role=host`;
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Something went wrong.";
    }
  });
</script>

<style>
  .page-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 40px 20px;
  }

  .create-panel {
    width: min(720px, 100%);
    padding: clamp(28px, 5vw, 52px);
    border: 1px solid var(--border);
    border-radius: 28px;
    background: rgba(18, 18, 24, .82);
    box-shadow: 0 30px 90px rgba(0, 0, 0, .35);
  }

  .back-link {
    color: var(--muted);
    text-decoration: none;
  }

  .back-link:hover { color: white; }

  .eyebrow {
    margin-top: 48px;
    color: #a78bfa;
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .16em;
  }

  h1 {
    margin: 12px 0 10px;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: .98;
  }

  .lead {
    color: var(--muted);
    line-height: 1.7;
    max-width: 600px;
  }

  .room-form {
    display: grid;
    gap: 20px;
    margin-top: 36px;
  }

  label {
    display: grid;
    gap: 9px;
    color: #d8d8e2;
    font-size: .9rem;
    font-weight: 700;
  }

  input, textarea, select {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #101016;
    color: white;
    padding: 14px 15px;
    font: inherit;
    outline: none;
  }

  input:focus, textarea:focus, select:focus {
    border-color: rgba(167, 139, 250, .8);
    box-shadow: 0 0 0 3px rgba(167, 139, 250, .12);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .primary-button {
    border: 0;
    border-radius: 14px;
    padding: 15px 20px;
    color: white;
    background: linear-gradient(135deg, #7c3aed, #06b6d4);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    margin-top: 6px;
  }

  .form-status {
    min-height: 24px;
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 620px) {
    .form-grid { grid-template-columns: 1fr; }
  }
</style>
